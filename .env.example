# Скопируйте в .env и при необходимости измените значения.

# --- Локальный запуск без Docker (по умолчанию SQLite, in-memory Qdrant, Celery в eager-режиме) ---
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# CELERY_TASK_ALWAYS_EAGER=true
# EMBEDDING_BACKEND=sentence-transformers   # или hashing — без torch
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Внешние API (необязательно; провайдер без ключа просто считается недоступным)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

JWT_SECRET=change-me-in-production-please-32b

# --- Docker ---
# Модели, которые ollama-init скачает при первом запуске
OLLAMA_PULL_MODELS=qwen2.5:7b qwen2.5:3b
# false — образ без torch/sentence-transformers (быстрее сборка, эмбеддинги hashing)
INSTALL_ML=true
HTTP_PORT=8080
